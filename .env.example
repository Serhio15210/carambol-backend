# Скопируй в `.env` и поправь значения. Docker Compose читает `.env` автоматически.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carambol
POSTGRES_PUBLISH_PORT=5432

# Nest запускается на хосте, поэтому localhost, а не имя сервиса `db`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carambol

# Auth
# Секрет подписи JWT: длинная случайная строка. Сгенерировать можно так:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Background jobs (cron). "false" switches them off, e.g. for a one-off script or the tests.
SCHEDULER_ENABLED=true

# Payments (Stripe, TEST mode). Get the keys at https://dashboard.stripe.com/test/apikeys and fill them in
# your own .env, never commit real values. The app starts without them; only paying needs them.
# STRIPE_WEBHOOK_SECRET is printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Minutes a booking waits for the payment before it is cancelled.
PAYMENT_WINDOW_MINUTES=15

# Seed (npm run seed): the first superadmin. Fill these in your own .env, never commit real values.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_PASSWORD=
