# Скопируй в `.env` и поправь значения. Docker Compose читает `.env` автоматически.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carambol
POSTGRES_PUBLISH_PORT=5432

# Nest запускается на хосте, поэтому localhost, а не имя сервиса `db`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carambol

# Auth
# Секрет подписи JWT: длинная случайная строка. Сгенерировать можно так:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Seed (npm run seed): the first superadmin. Fill these in your own .env, never commit real values.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_PASSWORD=
