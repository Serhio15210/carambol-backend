# Скопируй в `.env` и поправь значения. Docker Compose читает `.env` автоматически.

# PostgreSQL (docker compose + подключение Nest с хоста)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carambol

# Порт Postgres на твоей машине (host → контейнер)
POSTGRES_PUBLISH_PORT=5432

# Nest на хосте: localhost, не имя сервиса `db`
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carambol

# Приложение (опционально)
PORT=3000

# Auth
JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN_DAYS=30
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_AUTH_CLIENT_ID=auth-service
KAFKA_MAIL_CLIENT_ID=mail-service
KAFKA_MAIL_GROUP_ID=mail-service-consumer

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@carambol.local

# SMS
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Stripe
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_CURRENCY=usd
